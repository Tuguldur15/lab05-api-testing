  "item": [
    {
      "name": "1. Идэвхтэй оюутан урьдач хангасан үед бүртгэгдэнэ",
      "item": [
        {
          "name": "Setup 1: PUT /students/T1_STU",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/T1_STU",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "T1_STU"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}"
            }
          }
        },
        {
          "name": "Setup 2: PUT /courses/T1_CRS",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/T1_CRS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "T1_CRS"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}"
            }
          }
        },
        {
          "name": "1. Идэвхтэй оюутан урьдач хангасан үед бүртгэгдэнэ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"T1_STU\",\"courseID\":\"T1_CRS\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('result = OK', function () { pm.expect(pm.response.json().result).to.eql('OK'); });",
                  "pm.test('registrationID тоо байна', function () { pm.expect(pm.response.json().registrationID).to.be.a('number'); });"
                ]
              }
            }
          ]
        }
      ]
    },
